---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import { siteConfig } from '../lib/config';
---
<Layout
  title="Contact Friends Factory Cafe Vadodara | Book Candlelight Dinner | WhatsApp"
  description="Contact Friends Factory Cafe, Vadodara. Book a candlelight dinner, birthday surprise, or anniversary celebration via WhatsApp for instant confirmation. Located at Gotri, Vadodara."
  canonical="https://friendsfactorycafe.com/contact/"
  breadcrumbs={[
    { name: "Home", url: siteConfig.website },
    { name: "Contact", url: `${siteConfig.website}/contact/` },
  ]}
>
  <Header />

  <main class="pt-24">
    <section class="py-16 bg-gradient-to-br from-amber-50 via-white to-orange-50">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h1 class="font-serif text-4xl sm:text-5xl font-bold text-stone-900 mb-4">
            Get in <span class="gradient-text">Touch</span>
          </h1>
          <p class="text-stone-500 text-lg">We'd love to help plan your perfect celebration. Reach out via WhatsApp for instant response.</p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
          <!-- Contact Info -->
          <div class="space-y-4">
            <a
              href={`https://wa.me/${siteConfig.whatsapp}?text=Hi%20Friends%20Factory%20Cafe%2C%20I%20want%20to%20book%20a%20celebration`}
              target="_blank"
              rel="noopener noreferrer"
              class="glass rounded-2xl p-6 flex items-start gap-4 card-hover group block"
            >
              <div class="w-12 h-12 bg-[#25D366] rounded-xl flex items-center justify-center flex-shrink-0">
                <svg viewBox="0 0 24 24" class="w-7 h-7 fill-white"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              </div>
              <div>
                <div class="font-semibold text-stone-800 group-hover:text-primary">WhatsApp (Fastest Response)</div>
                <div class="text-stone-500 text-sm">{siteConfig.phone}</div>
                <div class="text-xs text-green-600 mt-1">⚡ Reply within minutes</div>
              </div>
            </a>

            <a href={`tel:${siteConfig.phone}`} class="glass rounded-2xl p-6 flex items-start gap-4 card-hover group block">
              <div class="w-12 h-12 bg-amber-500 rounded-xl flex items-center justify-center flex-shrink-0 text-white text-xl">📞</div>
              <div>
                <div class="font-semibold text-stone-800 group-hover:text-primary">Phone Call</div>
                <div class="text-stone-500 text-sm">{siteConfig.phone}</div>
                <div class="text-xs text-stone-400 mt-1">Available 11 AM – 10 PM</div>
              </div>
            </a>

            <a href={`mailto:${siteConfig.email}`} class="glass rounded-2xl p-6 flex items-start gap-4 card-hover group block">
              <div class="w-12 h-12 bg-amber-100 rounded-xl flex items-center justify-center flex-shrink-0 text-xl">✉️</div>
              <div>
                <div class="font-semibold text-stone-800 group-hover:text-primary">Email</div>
                <div class="text-stone-500 text-sm">{siteConfig.email}</div>
                <div class="text-xs text-stone-400 mt-1">Response within 24 hours</div>
              </div>
            </a>

            <div class="glass rounded-2xl p-6">
              <div class="text-xl mb-2">📍</div>
              <div class="font-semibold text-stone-800 mb-1">Visit Us</div>
              <div class="text-stone-500 text-sm leading-relaxed">{siteConfig.address}</div>
              <div class="text-stone-500 text-xs mt-2">🕐 Open 7 days · 11 AM – 11 PM</div>
            </div>
          </div>

          <!-- WhatsApp CTA -->
          <div class="glass rounded-2xl p-8 flex flex-col items-center justify-center text-center">
            <div class="text-6xl mb-4">🌹</div>
            <h2 class="font-serif text-2xl font-bold text-stone-900 mb-3">Ready to Book Your Celebration?</h2>
            <p class="text-stone-500 text-sm mb-6 leading-relaxed">
              Message us on WhatsApp with your occasion, preferred date, and number of guests. We'll confirm availability and share package details instantly.
            </p>
            <a
              href={`https://wa.me/${siteConfig.whatsapp}?text=Hi%20Friends%20Factory%20Cafe%21%20I'd%20like%20to%20book%20a%20celebration.%20Please%20share%20package%20details.`}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-primary gap-2 text-base px-8 py-4"
            >
              <svg viewBox="0 0 24 24" class="w-5 h-5 fill-white"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              Chat on WhatsApp
            </a>
            <p class="text-xs text-stone-400 mt-4">⚡ Instant reply · No advance payment to book</p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <WhatsAppFloat />
</Layout>
