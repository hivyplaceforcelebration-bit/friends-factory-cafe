---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import BookingForm from '../components/BookingForm.tsx';
import { siteConfig, packages, vadodaraAreas, services } from '../lib/config';

const faqs = [
  { question: "What is the starting price for a candlelight dinner at Friends Factory Cafe?", answer: "Our candlelight dinner packages start from ₹4,700 and include complete vegetarian meal, decorations, candles, and a welcome drink." },
  { question: "Where is Friends Factory Cafe located in Vadodara?", answer: "We are located at 424, OneWest, Asopalav W, 4th Floor, Priya Talkies Road, Gotri, Vadodara, Gujarat 391101." },
  { question: "Do you offer outdoor candlelight dinner in Vadodara?", answer: "Yes! We have a beautiful private rooftop setup for outdoor candlelight dinners with stunning city views. Rooftop packages start from ₹5,100." },
  { question: "Can I book a birthday surprise at Friends Factory Cafe?", answer: "Absolutely! We specialise in birthday surprises with balloon decorations, cake setup, and romantic ambiance. Contact us on WhatsApp to plan your special surprise." },
  { question: "Do you serve non-vegetarian food?", answer: "Currently we offer a complete vegetarian menu. All our packages include a multi-course vegetarian meal with welcome drink and dessert." },
  { question: "How far in advance should I book?", answer: "We recommend booking at least 2-3 days in advance to ensure availability, especially for weekends and special occasions." },
  { question: "Is the venue completely private?", answer: "Yes! Every booking at Friends Factory Cafe is 100% private. You get the entire setup exclusively for your celebration." },
  { question: "Do you help with proposal setups in Vadodara?", answer: "Yes, we specialise in surprise proposal setups with rose arch, ring placement, and complete private venue arrangement. Contact us to plan your perfect proposal." },
];
---
<Layout
  title="Friends Factory Cafe | Best Candlelight Dinner in Vadodara | Romantic Celebration Venue"
  description="Friends Factory Cafe — Vadodara's #1 private romantic celebration venue. Candlelight dinners, birthday surprises, anniversary setups & proposals from ₹4,700. 100% private rooftop & glass house. Book on WhatsApp!"
  faqs={faqs}
  breadcrumbs={[{ name: "Home", url: siteConfig.website }]}
>
  <Header />

  <!-- Hero -->
  <section class="relative min-h-screen flex items-center justify-center bg-gradient-to-br from-amber-50 via-white to-orange-50 overflow-hidden">
    <div class="absolute inset-0 pointer-events-none">
      <div class="absolute top-20 left-10 w-72 h-72 bg-amber-200 rounded-full opacity-20 blur-3xl"></div>
      <div class="absolute bottom-20 right-10 w-96 h-96 bg-orange-200 rounded-full opacity-20 blur-3xl"></div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-24 pb-16 w-full">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div class="text-center lg:text-left">
          <div class="inline-flex items-center gap-2 bg-amber-50 border border-amber-200 rounded-full px-4 py-1.5 text-sm font-medium text-amber-700 mb-6">
            ⭐ {siteConfig.rating}/5 · {siteConfig.reviewCount}+ Happy Couples
          </div>
          <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold text-stone-900 leading-tight mb-4">
            Vadodara's Most Romantic
            <span class="gradient-text block mt-1">Celebration Venue</span>
          </h1>
          <p class="text-stone-600 text-lg leading-relaxed mb-8 max-w-lg mx-auto lg:mx-0">
            Private rooftop & glass house experiences for candlelight dinners, birthday surprises, proposals & anniversaries. Starting just ₹4,700.
          </p>
          <div class="flex flex-wrap gap-3 justify-center lg:justify-start mb-8">
            <a href={`https://wa.me/${siteConfig.whatsapp}?text=Hi%20Friends%20Factory%20Cafe%2C%20I%20want%20to%20book%20a%20candlelight%20dinner`} target="_blank" rel="noopener noreferrer" class="btn-primary gap-2">
              <svg viewBox="0 0 24 24" class="w-5 h-5 fill-white"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              Book Now on WhatsApp
            </a>
            <a href="/packages/" class="inline-flex items-center justify-center border-2 border-amber-400 text-amber-700 font-semibold px-5 py-3 rounded-xl hover:bg-amber-50 transition-colors">
              View Packages →
            </a>
          </div>
          <div class="flex flex-wrap gap-4 justify-center lg:justify-start text-sm text-stone-500">
            <span>✅ 100% Private Venue</span>
            <span>🍽️ Complete Meal Included</span>
            <span>📸 Photo-Ready Decor</span>
          </div>
        </div>

        <!-- Booking Form -->
        <div class="w-full">
          <BookingForm client:load whatsapp={siteConfig.whatsapp} service="candlelight dinner" location="Vadodara" />
        </div>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="py-20 bg-stone-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="font-serif text-3xl sm:text-4xl font-bold text-stone-900 mb-3">What We Celebrate</h2>
        <p class="text-stone-500 max-w-xl mx-auto">Every occasion deserves a perfectly curated private experience</p>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4">
        {services.map(service => (
          <a href={`/${service.slug}-vadodara/`} class="glass rounded-2xl p-4 text-center card-hover group">
            <div class="text-3xl mb-2">{service.emoji}</div>
            <div class="text-xs font-semibold text-stone-700 group-hover:text-primary transition-colors">{service.name}</div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Packages -->
  <section class="py-20 bg-white" id="packages">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="font-serif text-3xl sm:text-4xl font-bold text-stone-900 mb-3">Our Celebration Packages</h2>
        <p class="text-stone-500 max-w-xl mx-auto">Curated experiences from ₹4,700 — all-inclusive with meal, decor & ambiance</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {packages.map((pkg, idx) => (
          <div class={`rounded-2xl p-6 card-hover relative ${idx === 4 ? 'bg-gradient-to-br from-primary to-accent text-white shadow-xl shadow-amber-200' : 'glass'}`}>
            {idx === 4 && (
              <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-stone-900 text-white text-xs font-bold px-3 py-1 rounded-full">⭐ Most Popular</div>
            )}
            <div class="text-3xl mb-3">{pkg.emoji}</div>
            <h3 class={`font-serif font-bold text-base mb-1 ${idx === 4 ? 'text-white' : 'text-stone-900'}`}>{pkg.name}</h3>
            <div class={`text-2xl font-bold mb-3 ${idx === 4 ? 'text-white' : 'gradient-text'}`}>{pkg.price}</div>
            <p class={`text-xs leading-relaxed mb-4 ${idx === 4 ? 'text-white/90' : 'text-stone-500'}`}>{pkg.description}</p>
            <a
              href={`https://wa.me/${siteConfig.whatsapp}?text=Hi%20Friends%20Factory%20Cafe%2C%20I'm%20interested%20in%20the%20${encodeURIComponent(pkg.name)}%20package`}
              target="_blank"
              rel="noopener noreferrer"
              class={`text-xs font-semibold py-2 px-4 rounded-lg transition-all ${idx === 4 ? 'bg-white text-amber-700 hover:bg-amber-50' : 'btn-primary'}`}
            >
              Book This Package
            </a>
          </div>
        ))}
      </div>
      <div class="text-center mt-8">
        <a href="/packages/" class="inline-flex items-center gap-2 text-amber-700 font-semibold hover:underline">
          View All Packages & Details →
        </a>
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section class="py-20 bg-amber-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="font-serif text-3xl sm:text-4xl font-bold text-stone-900 mb-3">How It Works</h2>
        <p class="text-stone-500">3 simple steps to your perfect celebration</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {[
          { step: "01", emoji: "💬", title: "Chat on WhatsApp", desc: "Message us with your occasion, preferred date, and number of guests. We respond instantly." },
          { step: "02", emoji: "🗓️", title: "Confirm Your Slot", desc: "Choose your package, confirm the date, and we'll set everything up specially for you." },
          { step: "03", emoji: "✨", title: "Arrive & Celebrate", desc: "Walk in to a beautifully decorated private space — everything is ready for your magical moment." },
        ].map(s => (
          <div class="glass rounded-2xl p-6 text-center card-hover">
            <div class="text-4xl mb-3">{s.emoji}</div>
            <div class="text-xs font-bold text-amber-600 uppercase tracking-widest mb-2">Step {s.step}</div>
            <h3 class="font-serif font-bold text-lg text-stone-900 mb-2">{s.title}</h3>
            <p class="text-sm text-stone-500 leading-relaxed">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Areas -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <h2 class="font-serif text-3xl sm:text-4xl font-bold text-stone-900 mb-3">We Serve All Areas of Vadodara</h2>
        <p class="text-stone-500">Friends Factory Cafe is easily accessible from every corner of Vadodara</p>
      </div>
      <div class="flex flex-wrap gap-2 justify-center">
        {vadodaraAreas.map(area => (
          <a
            href={`/${area.slug}-candlelight-dinner/`}
            class="glass rounded-full px-4 py-1.5 text-sm text-stone-600 hover:text-primary hover:border-amber-300 transition-colors card-hover"
          >
            {area.name}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20 bg-stone-50">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <h2 class="font-serif text-3xl sm:text-4xl font-bold text-stone-900 mb-3">Frequently Asked Questions</h2>
        <p class="text-stone-500">Everything you need to know before booking</p>
      </div>
      <div class="space-y-3" id="faq-list">
        {faqs.map((faq, idx) => (
          <div class="glass rounded-xl overflow-hidden" data-faq={idx}>
            <button class="faq-btn w-full flex items-center justify-between p-5 text-left hover:bg-amber-50/50 transition-colors">
              <span class="font-semibold text-stone-800 text-sm pr-4">{faq.question}</span>
              <span class="faq-icon flex-shrink-0 w-5 h-5 text-amber-600 transition-transform">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
              </span>
            </button>
            <div class="faq-answer hidden px-5 pb-5">
              <p class="text-stone-600 text-sm leading-relaxed">{faq.answer}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 bg-gradient-to-br from-amber-500 to-amber-700">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-serif text-3xl sm:text-4xl font-bold text-white mb-4">
        Ready to Create a Memory That Lasts Forever?
      </h2>
      <p class="text-amber-100 mb-8 text-lg">
        Book your private celebration at Friends Factory Cafe today. Starting from ₹4,700.
      </p>
      <a
        href={`https://wa.me/${siteConfig.whatsapp}?text=Hi%20Friends%20Factory%20Cafe%2C%20I'd%20like%20to%20book%20a%20celebration!`}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 bg-white text-amber-700 font-bold px-8 py-4 rounded-xl hover:bg-amber-50 transition-colors shadow-lg text-lg"
      >
        <svg viewBox="0 0 24 24" class="w-6 h-6 fill-[#25D366]"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        Book on WhatsApp — Instant Reply
      </a>
    </div>
  </section>

  <Footer />
  <WhatsAppFloat />
</Layout>

<script>
  document.querySelectorAll('.faq-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const parent = btn.closest('[data-faq]');
      const answer = parent?.querySelector('.faq-answer');
      const icon = btn.querySelector('.faq-icon');
      const isOpen = !answer?.classList.contains('hidden');
      document.querySelectorAll('.faq-answer').forEach(a => a.classList.add('hidden'));
      document.querySelectorAll('.faq-icon').forEach(i => (i as HTMLElement).style.transform = '');
      if (!isOpen) {
        answer?.classList.remove('hidden');
        if (icon) (icon as HTMLElement).style.transform = 'rotate(180deg)';
      }
    });
  });
</script>
