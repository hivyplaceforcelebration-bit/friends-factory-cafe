---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import BookingForm from '../components/BookingForm.tsx';
import { siteConfig, packages, vadodaraAreas, services, keywordPages } from '../lib/config';

export async function getStaticPaths() {
  const paths: any[] = [];

  // Area × Service pages — e.g. /alkapuri-candlelight-dinner/
  const serviceKeywords = [
    { keyword: "candlelight-dinner", label: "Candlelight Dinner", emoji: "🕯️", priceFrom: "₹4,700" },
    { keyword: "birthday-surprise", label: "Birthday Surprise", emoji: "🎂", priceFrom: "₹4,700" },
    { keyword: "anniversary-dinner", label: "Anniversary Dinner", emoji: "💑", priceFrom: "₹4,700" },
    { keyword: "proposal-setup", label: "Proposal Setup", emoji: "💍", priceFrom: "₹5,100" },
    { keyword: "date-night", label: "Date Night", emoji: "🌙", priceFrom: "₹4,700" },
    { keyword: "romantic-dinner", label: "Romantic Dinner", emoji: "🍽️", priceFrom: "₹4,700" },
  ];

  for (const area of vadodaraAreas) {
    for (const svc of serviceKeywords) {
      const slug = `${area.slug}-${svc.keyword}`;
      paths.push({
        params: { slug },
        props: {
          type: "area-service",
          areaName: area.name,
          areaSlug: area.slug,
          serviceName: svc.label,
          serviceEmoji: svc.emoji,
          serviceKeyword: svc.keyword,
          priceFrom: svc.priceFrom,
          title: `${svc.label} in ${area.name}, Vadodara | Friends Factory Cafe | From ${svc.priceFrom}`,
          h1: `Best ${svc.label} in ${area.name}, Vadodara`,
          description: `Book a private ${svc.label.toLowerCase()} near ${area.name}, Vadodara at Friends Factory Cafe. Intimate rooftop & glass house setups from ${svc.priceFrom}. WhatsApp for instant confirmation!`,
        },
      });
    }
  }

  // Keyword pages from config
  for (const kw of keywordPages) {
    paths.push({
      params: { slug: kw.slug },
      props: {
        type: "keyword",
        title: `${kw.title} | Friends Factory Cafe`,
        h1: kw.h1,
        description: kw.description,
        serviceName: kw.service,
        serviceEmoji: "🌹",
        priceFrom: "₹4,700",
        areaName: "Vadodara",
        areaSlug: "",
        serviceKeyword: kw.slug,
      },
    });
  }

  return paths;
}

const {
  type,
  title,
  h1,
  description,
  areaName,
  areaSlug,
  serviceName,
  serviceEmoji,
  serviceKeyword,
  priceFrom,
} = Astro.props;

const isAreaPage = type === "area-service";

const faqs = [
  {
    question: `What is the starting price for ${serviceName.toLowerCase()} in ${areaName}?`,
    answer: `${serviceName} at Friends Factory Cafe starts from ${priceFrom} and includes complete vegetarian meal, decorations, candles, and welcome drink. We're located in Gotri, Vadodara — easily accessible from ${areaName}.`
  },
  {
    question: `Is there a private ${serviceName.toLowerCase()} venue near ${areaName}, Vadodara?`,
    answer: `Yes! Friends Factory Cafe offers 100% private ${serviceName.toLowerCase()} setups at our Gotri venue, which is easily accessible from ${areaName}, Vadodara. Each booking is completely exclusive.`
  },
  {
    question: `How do I book a ${serviceName.toLowerCase()} near ${areaName}?`,
    answer: `Simply WhatsApp us at ${siteConfig.phone} with your preferred date, occasion type, and number of guests. We'll confirm availability and send package details instantly.`
  },
  {
    question: `Do you offer home delivery or setup in ${areaName}?`,
    answer: `We offer a dedicated private venue experience at our Gotri location, Vadodara — not home delivery. The venue is fully private and includes professional decoration, meal, and ambiance.`
  },
  {
    question: `Is the food vegetarian at Friends Factory Cafe?`,
    answer: `Yes, we offer a complete vegetarian menu including starters, main course, and dessert. All packages include a multi-course vegetarian meal.`
  },
];

const breadcrumbs = [
  { name: "Home", url: siteConfig.website },
  ...(isAreaPage ? [
    { name: areaName, url: `${siteConfig.website}/${areaSlug}-candlelight-dinner/` },
    { name: serviceName, url: `${siteConfig.website}/${areaSlug}-${serviceKeyword}/` },
  ] : [
    { name: serviceName, url: `${siteConfig.website}/${serviceKeyword}/` },
  ]),
];

const waMsg = encodeURIComponent(`Hi Friends Factory Cafe! I want to book a ${serviceName} in ${areaName}, Vadodara. Please share package details and availability.`);
const waUrl = `https://wa.me/${siteConfig.whatsapp}?text=${waMsg}`;
---
<Layout
  title={title}
  description={description}
  canonical={`${siteConfig.website}/${Astro.params.slug}/`}
  faqs={faqs}
  breadcrumbs={breadcrumbs}
>
  <Header />

  <main class="pt-20">
    <!-- Hero -->
    <section class="py-16 bg-gradient-to-br from-amber-50 via-white to-orange-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div>
            <!-- Breadcrumb -->
            <nav class="text-xs text-stone-400 mb-4 flex flex-wrap gap-1 items-center">
              <a href="/" class="hover:text-primary">Home</a>
              <span>/</span>
              {isAreaPage && <><span class="text-stone-500">{areaName}</span><span>/</span></>}
              <span class="text-stone-600">{serviceName}</span>
            </nav>

            <div class="inline-flex items-center gap-2 bg-amber-50 border border-amber-200 rounded-full px-4 py-1.5 text-sm font-medium text-amber-700 mb-4">
              {serviceEmoji} {serviceName} in {areaName}
            </div>
            <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-stone-900 mb-4 leading-tight">
              {h1}
            </h1>
            <p class="text-stone-600 text-lg mb-6 leading-relaxed">
              {description}
            </p>
            <div class="flex flex-wrap gap-3 mb-6">
              <a href={waUrl} target="_blank" rel="noopener noreferrer" class="btn-primary gap-2">
                <svg viewBox="0 0 24 24" class="w-5 h-5 fill-white"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                Book {serviceName} Now
              </a>
              <a href="/packages/" class="inline-flex items-center justify-center border-2 border-amber-400 text-amber-700 font-semibold px-5 py-3 rounded-xl hover:bg-amber-50 transition-colors text-sm">
                View Packages →
              </a>
            </div>
            <div class="flex flex-wrap gap-4 text-sm text-stone-500">
              <span>✅ 100% Private</span>
              <span>🍽️ Meal Included</span>
              <span>📍 Gotri, Vadodara</span>
              <span>💰 From {priceFrom}</span>
            </div>
          </div>

          <!-- Booking Form -->
          <div>
            <BookingForm client:load whatsapp={siteConfig.whatsapp} service={serviceName} location={`${areaName}, Vadodara`} />
          </div>
        </div>
      </div>
    </section>

    <!-- Why Choose Us -->
    <section class="py-16 bg-white">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-stone-900 mb-8 text-center">
          Why Choose Friends Factory Cafe for {serviceName} in {areaName}?
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
          {[
            { emoji: "🔒", title: "100% Private Venue", desc: "Exclusive booking — the entire setup is only for you. No shared spaces." },
            { emoji: "🌹", title: "Beautiful Decor", desc: "Candles, flowers, fairy lights — professionally arranged photo-ready setup." },
            { emoji: "🍽️", title: "Complete Meal", desc: "Multi-course vegetarian meal, starters, dessert & welcome drink included." },
            { emoji: "⚡", title: "Easy WhatsApp Booking", desc: "Message us, get confirmed in minutes. No advance payment to hold your slot." },
          ].map(f => (
            <div class="glass rounded-2xl p-5 card-hover text-center">
              <div class="text-3xl mb-3">{f.emoji}</div>
              <h3 class="font-semibold text-stone-800 mb-2 text-sm">{f.title}</h3>
              <p class="text-xs text-stone-500 leading-relaxed">{f.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Packages -->
    <section class="py-16 bg-stone-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-stone-900 mb-8 text-center">
          {serviceName} Packages in {areaName}
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
          {packages.slice(0, 4).map((pkg, idx) => (
            <div class={`rounded-2xl p-5 card-hover relative ${idx === 1 ? 'bg-gradient-to-br from-primary to-accent text-white shadow-xl shadow-amber-200' : 'glass'}`}>
              {idx === 1 && <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-stone-900 text-white text-xs font-bold px-3 py-1 rounded-full">⭐ Popular</div>}
              <div class="text-2xl mb-2">{pkg.emoji}</div>
              <h3 class={`font-serif font-bold text-sm mb-1 ${idx === 1 ? 'text-white' : 'text-stone-900'}`}>{pkg.name}</h3>
              <div class={`text-xl font-bold mb-2 ${idx === 1 ? 'text-white' : 'gradient-text'}`}>{pkg.price}</div>
              <p class={`text-xs mb-3 ${idx === 1 ? 'text-white/90' : 'text-stone-500'}`}>{pkg.description.substring(0, 80)}...</p>
              <div class={`text-[11px] font-semibold mb-3 inline-flex items-center gap-1 rounded-full px-2.5 py-1 ${idx === 1 ? 'bg-white/15 text-white' : 'bg-amber-50 text-amber-700 border border-amber-200'}`}>
                <span>🎥</span>
                Add Photography / Reel Video · ₹2,500
              </div>
              <a
                href={`https://wa.me/${siteConfig.whatsapp}?text=Hi%20Friends%20Factory%20Cafe%2C%20I%20want%20${encodeURIComponent(pkg.name)}%20for%20${encodeURIComponent(serviceName)}%20near%20${encodeURIComponent(areaName)}`}
                target="_blank"
                rel="noopener noreferrer"
                class={`text-xs font-semibold py-2 px-3 rounded-lg block text-center transition-all ${idx === 1 ? 'bg-white text-amber-700 hover:bg-amber-50' : 'btn-primary'}`}
              >
                Book Now
              </a>
            </div>
          ))}
        </div>
        <div class="text-center mt-6">
          <a href="/packages/" class="text-amber-700 font-semibold hover:underline text-sm">
            See All 8 Packages →
          </a>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-16 bg-white">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-stone-900 mb-8 text-center">
          FAQ — {serviceName} in {areaName}, Vadodara
        </h2>
        <div class="space-y-3" id="faq-list">
          {faqs.map((faq, idx) => (
            <div class="glass rounded-xl overflow-hidden" data-faq={idx}>
              <button class="faq-btn w-full flex items-center justify-between p-5 text-left hover:bg-amber-50/50 transition-colors">
                <span class="font-semibold text-stone-800 text-sm pr-4">{faq.question}</span>
                <span class="faq-icon flex-shrink-0 w-5 h-5 text-amber-600 transition-transform">
                  <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
                </span>
              </button>
              <div class="faq-answer hidden px-5 pb-5">
                <p class="text-stone-600 text-sm leading-relaxed">{faq.answer}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Related Areas -->
    {isAreaPage && (
      <section class="py-12 bg-stone-50">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
          <h2 class="font-serif text-xl font-bold text-stone-900 mb-5 text-center">
            {serviceName} in Nearby Areas
          </h2>
          <div class="flex flex-wrap gap-2 justify-center">
            {vadodaraAreas.filter(a => a.slug !== areaSlug).slice(0, 12).map(area => (
              <a
                href={`/${area.slug}-${serviceKeyword}/`}
                class="glass rounded-full px-4 py-1.5 text-sm text-stone-600 hover:text-primary transition-colors"
              >
                {area.name}
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- CTA -->
    <section class="py-16 bg-gradient-to-br from-amber-500 to-amber-700">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-white mb-4">
          Book Your {serviceName} in {areaName} Today!
        </h2>
        <p class="text-amber-100 mb-8 text-lg">Starting from {priceFrom} · Instant WhatsApp confirmation · 100% Private</p>
        <a
          href={waUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-white text-amber-700 font-bold px-8 py-4 rounded-xl hover:bg-amber-50 transition-colors shadow-lg text-lg"
        >
          <svg viewBox="0 0 24 24" class="w-6 h-6 fill-[#25D366]"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          Book on WhatsApp
        </a>
      </div>
    </section>
  </main>

  <Footer />
  <WhatsAppFloat />
</Layout>

<script>
  document.querySelectorAll('.faq-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const parent = btn.closest('[data-faq]');
      const answer = parent?.querySelector('.faq-answer');
      const icon = btn.querySelector('.faq-icon');
      const isOpen = !answer?.classList.contains('hidden');
      document.querySelectorAll('.faq-answer').forEach(a => a.classList.add('hidden'));
      document.querySelectorAll('.faq-icon').forEach(i => (i as HTMLElement).style.transform = '');
      if (!isOpen) {
        answer?.classList.remove('hidden');
        if (icon) (icon as HTMLElement).style.transform = 'rotate(180deg)';
      }
    });
  });
</script>
